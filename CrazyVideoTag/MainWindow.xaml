<Window x:Class="CrazyVideoTag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CrazyVideoTag.Models"
        xmlns:vm="clr-namespace:CrazyVideoTag.ViewModels"
        xmlns:controls="clr-namespace:CrazyVideoTag.Controls"
        Title="CrazyVideoTag v1.1.23" Height="860" Width="1320" MinHeight="720" MinWidth="1080"
        Background="{StaticResource Bg}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="TagChipTemplate" DataType="{x:Type models:TagDefinition}">
            <Border Background="{Binding Color, Converter={StaticResource ColorBrush}}" CornerRadius="6" Padding="8,3" Margin="0,0,5,5">
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TagRowTemplate" DataType="{x:Type vm:SelectableTagViewModel}">
            <Border Style="{StaticResource TagRowStyle}" MouseLeftButtonDown="TagRow_MouseLeftButtonDown" PreviewMouseLeftButtonDown="TagRow_PreviewMouseLeftButtonDown" MouseMove="TagRow_MouseMove" DragOver="TagRow_DragOver" Drop="TagRow_Drop" AllowDrop="True">
                <DockPanel LastChildFill="True">
                    <Border Width="6" CornerRadius="3" Background="{Binding Color, Converter={StaticResource ColorBrush}}" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
                    <Button DockPanel.Dock="Right" Content="删除" Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" Margin="8,0,0,0" Style="{StaticResource DangerButtonStyle}" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" FontSize="13" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FilterTagRowTemplate" DataType="{x:Type vm:SelectableTagViewModel}">
            <Border Style="{StaticResource TagRowStyle}" MouseLeftButtonDown="TagRow_MouseLeftButtonDown" PreviewMouseLeftButtonDown="TagRow_PreviewMouseLeftButtonDown" MouseMove="TagRow_MouseMove" DragOver="TagRow_DragOver" Drop="TagRow_Drop" AllowDrop="True">
                <DockPanel>
                    <Border Width="6" CornerRadius="3" Background="{Binding Color, Converter={StaticResource ColorBrush}}" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" FontSize="13" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VideoCardTemplate" DataType="{x:Type models:VideoItem}">
            <Border Width="250" Height="240" Margin="9" Style="{StaticResource VideoCardStyle}" MouseLeftButtonDown="VideoCard_MouseLeftButtonDown" MouseRightButtonDown="VideoCard_MouseRightButtonDown">
                <Border.RenderTransform>
                    <TranslateTransform Y="0" />
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="设置封面图片..." Command="{Binding PlacementTarget.DataContext.SetCustomCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Margin="9,9,9,12">
                    <Grid Width="229" Height="140">
                        <Border Background="#0C0E12" CornerRadius="10" />
                        <Image Source="{Binding EffectiveThumbnailPath}" Stretch="UniformToFill" Width="229" Height="140">
                            <Image.Clip>
                                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,229,140" />
                            </Image.Clip>
                        </Image>
                        <Border Background="#161B24" CornerRadius="10" Visibility="{Binding EffectiveThumbnailPath, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontSize="26" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="封面未生成" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TagIdsToDefinitions}">
                                    <Binding Path="TagIds" />
                                    <Binding Path="DataContext.AllTagDefinitions" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Margin>8</ItemsControl.Margin>
                        </ItemsControl>
                        <ItemsControl ItemTemplate="{StaticResource TagChipTemplate}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TagIdsToDefinitions}">
                                    <Binding Path="ActorIds" />
                                    <Binding Path="DataContext.AllTagDefinitions" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Margin>8</ItemsControl.Margin>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" LineHeight="19" MaxHeight="42" Margin="2,10,2,0" />
                    <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="2,5,2,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,11">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="选择 / 替换文件夹" Command="{Binding ChooseFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="重新扫描" Command="{Binding RescanCommand}" />
                    <Button Content="配置 FFmpeg" Command="{Binding ConfigureToolsCommand}" />
                    <Button Content="配置存储目录" Command="{Binding ConfigureStorageCommand}" />
                    <Button Content="生成选中封面" Command="{Binding GenerateSelectedThumbnailCommand}" />
                    <Button Content="剪切" Command="{Binding CutCommand}" />
                    <Button Content="粘贴" Command="{Binding PasteCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="搜索" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,6,0" FontSize="13" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=Explicit}" MinWidth="180" VerticalAlignment="Center" ToolTip="输入标题关键字后按回车搜索" KeyDown="SearchBox_KeyDown" />
                    <TextBlock Text="排序" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,6,0" FontSize="13" />
                    <ComboBox ItemsSource="{Binding SortModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding SortMode, Mode=TwoWay}" MinWidth="170" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayedCountText}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13" />
                    <TextBlock Text="{Binding ThumbnailCompleted, StringFormat=封面 {0}}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13" />
                    <TextBlock Text="/" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ThumbnailTotal}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentFolder}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0" FontSize="13" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid Visibility="{Binding IsStartPageVisible, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                        <Border HorizontalAlignment="Center" Width="76" Height="76" CornerRadius="20" Background="{StaticResource AccentSoft}" Margin="0,0,0,26">
                            <TextBlock Text="▶" FontSize="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Border>
                        <TextBlock Text="CrazyVideoTag" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextStrong}" />
                        <TextBlock Text="本地视频标签管理工具" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="选择一个文件夹，开始扫描和管理你的本地视频标签。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,22,0,34" FontSize="14" />
                        <Button Content="选择文件夹" Command="{Binding ChooseFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="50" FontSize="15" />
                    </StackPanel>
                </Grid>

                <TabControl x:Name="MainTabControl" Visibility="{Binding CurrentFolder, Converter={StaticResource NullVisibility}}" Margin="10">
                    <TabItem Header="文件夹">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="12" Margin="0,0,10,0">
                                <TreeView x:Name="FolderTree" ItemsSource="{Binding FolderTreeRoots}" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>
                            <ScrollViewer x:Name="FolderVideoScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                <ItemsControl ItemsSource="{Binding DisplayedVideos}" ItemTemplate="{StaticResource VideoCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:VirtualizingWrapPanel ItemWidth="268" ItemHeight="258" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="筛选">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="14" Margin="0,0,10,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="普通标签（交集）" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,8" FontSize="13" />
                                        <ItemsControl ItemsSource="{Binding FilterTagRows}" ItemTemplate="{StaticResource FilterTagRowTemplate}" />
                                        <TextBlock Text="演员（并集）" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,18,0,8" FontSize="13" />
                                        <ItemsControl ItemsSource="{Binding FilterActorRows}" ItemTemplate="{StaticResource FilterTagRowTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <ScrollViewer x:Name="FilterVideoScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                <ItemsControl ItemsSource="{Binding DisplayedVideos}" ItemTemplate="{StaticResource VideoCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:VirtualizingWrapPanel ItemWidth="268" ItemHeight="258" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1,0,0,0" Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="标签功能区" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,14" />
                    <TabControl>
                        <TabItem Header="普通标签">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel>
                                    <Button Content="+ 添加标签" Command="{Binding AddTagCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding TagRows}" ItemTemplate="{StaticResource TagRowTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="演员">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel>
                                    <Button Content="+ 添加演员" Command="{Binding AddActorCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding ActorRows}" ItemTemplate="{StaticResource TagRowTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
