<Window x:Class="CrazyVideoTag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CrazyVideoTag.Models"
        xmlns:vm="clr-namespace:CrazyVideoTag.ViewModels"
        Title="CrazyVideoTag v1.1.12" Height="860" Width="1320" MinHeight="720" MinWidth="1080"
        Background="{StaticResource Bg}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="TagChipTemplate" DataType="{x:Type models:TagDefinition}">
            <Border Background="{Binding Color, Converter={StaticResource ColorBrush}}" CornerRadius="6" Padding="7,3" Margin="0,0,5,5">
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TagRowTemplate" DataType="{x:Type vm:SelectableTagViewModel}">
            <Border Style="{StaticResource TagRowStyle}" MouseLeftButtonDown="TagRow_MouseLeftButtonDown" PreviewMouseLeftButtonDown="TagRow_PreviewMouseLeftButtonDown" MouseMove="TagRow_MouseMove" DragOver="TagRow_DragOver" Drop="TagRow_Drop" AllowDrop="True">
                <DockPanel LastChildFill="True">
                    <Border Width="6" CornerRadius="3" Background="{Binding Color, Converter={StaticResource ColorBrush}}" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
                    <Button DockPanel.Dock="Right" Content="删除" Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="7,3" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FilterTagRowTemplate" DataType="{x:Type vm:SelectableTagViewModel}">
            <Border Style="{StaticResource TagRowStyle}" MouseLeftButtonDown="TagRow_MouseLeftButtonDown" PreviewMouseLeftButtonDown="TagRow_PreviewMouseLeftButtonDown" MouseMove="TagRow_MouseMove" DragOver="TagRow_DragOver" Drop="TagRow_Drop" AllowDrop="True">
                <DockPanel>
                    <Border Width="6" CornerRadius="3" Background="{Binding Color, Converter={StaticResource ColorBrush}}" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VideoCardTemplate" DataType="{x:Type models:VideoItem}">
            <Border Width="250" Margin="8" Padding="5" CornerRadius="12" Background="{StaticResource CardBg}" MouseLeftButtonDown="VideoCard_MouseLeftButtonDown" MouseRightButtonDown="VideoCard_MouseRightButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="设置封面图片..." Command="{Binding PlacementTarget.DataContext.SetCustomCoverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Width="240" Height="150" ClipToBounds="True">
                        <Border Background="#0C0E12" CornerRadius="8" />
                        <Image Source="{Binding EffectiveThumbnailPath}" Stretch="UniformToFill" Width="240" Height="150" />
                        <TextBlock Text="封面未生成" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Visibility="{Binding EffectiveThumbnailPath, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}" />
                        <ItemsControl ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TagIdsToDefinitions}">
                                    <Binding Path="TagIds" />
                                    <Binding Path="DataContext.AllTagDefinitions" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Margin>8</ItemsControl.Margin>
                        </ItemsControl>
                        <ItemsControl ItemTemplate="{StaticResource TagChipTemplate}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TagIdsToDefinitions}">
                                    <Binding Path="ActorIds" />
                                    <Binding Path="DataContext.AllTagDefinitions" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Margin>8</ItemsControl.Margin>
                        </ItemsControl>
                    </Grid>
                    <DockPanel Height="74" Margin="2,9,2,0">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding InfoText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource TextMain}" LineHeight="18" MaxHeight="56" VerticalAlignment="Top" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="选择/替换文件夹" Command="{Binding ChooseFolderCommand}" />
                    <Button Content="重新扫描" Command="{Binding RescanCommand}" />
                    <Button Content="配置 FFmpeg" Command="{Binding ConfigureToolsCommand}" />
                    <Button Content="配置存储目录" Command="{Binding ConfigureStorageCommand}" />
                    <Button Content="生成选中封面" Command="{Binding GenerateSelectedThumbnailCommand}" />
                    <Button Content="剪切" Command="{Binding CutCommand}" />
                    <Button Content="粘贴" Command="{Binding PasteCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="搜索标题：" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=Explicit}" MinWidth="180" VerticalAlignment="Center" ToolTip="输入标题关键字后按回车搜索" KeyDown="SearchBox_KeyDown" />
                    <TextBlock Text="排序：" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox ItemsSource="{Binding SortModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding SortMode, Mode=TwoWay}" MinWidth="160" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayedCountText}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Text="{Binding ThumbnailCompleted, StringFormat=封面 {0}}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="/" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ThumbnailTotal}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentFolder}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid Visibility="{Binding IsStartPageVisible, Converter={StaticResource NullVisibility}, ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <TextBlock Text="CrazyVideoTag" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="请选择一个文件夹开始扫描和管理本地视频标签。" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18" />
                        <Button Content="选择文件夹" Command="{Binding ChooseFolderCommand}" Height="46" />
                    </StackPanel>
                </Grid>

                <TabControl Visibility="{Binding CurrentFolder, Converter={StaticResource NullVisibility}}" Margin="10">
                    <TabItem Header="文件夹">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="10" Margin="0,0,10,0">
                                <TreeView x:Name="FolderTree" ItemsSource="{Binding FolderTreeRoots}" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" ScrollChanged="VideoScrollViewer_ScrollChanged">
                                <ItemsControl ItemsSource="{Binding DisplayedVideos}" ItemTemplate="{StaticResource VideoCardTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="筛选">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Background="{StaticResource PanelBg}" Margin="0,0,10,0" Padding="10" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="普通标签（交集）" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding FilterTagRows}" ItemTemplate="{StaticResource FilterTagRowTemplate}" />
                                    <TextBlock Text="演员（并集）" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,18,0,8" />
                                    <ItemsControl ItemsSource="{Binding FilterActorRows}" ItemTemplate="{StaticResource FilterTagRowTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" ScrollChanged="VideoScrollViewer_ScrollChanged">
                                <ItemsControl ItemsSource="{Binding DisplayedVideos}" ItemTemplate="{StaticResource VideoCardTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="标签功能区" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,14" />
                        <Expander Header="普通标签" IsExpanded="True" Foreground="{StaticResource TextStrong}" FontWeight="SemiBold">
                            <StackPanel>
                                <Button Content="添加" Command="{Binding AddTagCommand}" Padding="8,4" HorizontalAlignment="Left" Margin="0,6,0,8" />
                                <ItemsControl ItemsSource="{Binding TagRows}" ItemTemplate="{StaticResource TagRowTemplate}" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="演员" IsExpanded="True" Foreground="{StaticResource TextStrong}" FontWeight="SemiBold" Margin="0,16,0,0">
                            <StackPanel>
                                <Button Content="添加" Command="{Binding AddActorCommand}" Padding="8,4" HorizontalAlignment="Left" Margin="0,6,0,8" />
                                <ItemsControl ItemsSource="{Binding ActorRows}" ItemTemplate="{StaticResource TagRowTemplate}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
