<Window x:Class="CrazyVideoTag.Views.TagEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加标签" Height="380" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="名称" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" FontSize="13" />
        <TextBox x:Name="NameBox" Grid.Row="1" Height="40" />
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="颜色" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" FontSize="13" />
            <ListBox x:Name="ColorList" Height="180" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="44" Height="34" CornerRadius="8" Margin="4" Background="{Binding Converter={StaticResource ColorBrush}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="80" />
            <Button Content="确定" Click="Confirm_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
