<Window x:Class="CrazyVideoTag.Views.ToolPathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 FFmpeg" Height="240" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="ffmpeg" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="13" />
        <TextBox x:Name="FfmpegBox" Grid.Column="1" Margin="0,0,8,14" />
        <Button Grid.Column="2" Content="浏览" Click="BrowseFfmpeg_Click" Margin="0,0,0,14" />

        <TextBlock Grid.Row="1" Text="ffprobe" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="13" />
        <TextBox x:Name="FfprobeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,14" />
        <Button Grid.Row="1" Grid.Column="2" Content="浏览" Click="BrowseFfprobe_Click" Margin="0,0,0,14" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="80" />
            <Button Content="确定" Click="Confirm_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
